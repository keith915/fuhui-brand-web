{
  "name": "fuhui-brand-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/src/index.ts",
    "build:site": "node scripts/build-site.mjs",
    "build:admin": "vite build --config admin/vite.config.ts",
    "build": "npm run build:admin && npm run build:site",
    "seed": "node scripts/seed-from-site.mjs",
    "backup": "node scripts/backup.mjs",
    "start": "node server/src/index.ts",
    "test": "node --test \"server/test/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1",
    "linkedom": "^0.18.12",
    "sharp": "^0.34.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "antd": "^5.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
